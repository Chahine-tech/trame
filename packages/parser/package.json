{
  "name": "tramejs",
  "version": "0.2.0",
  "type": "module",
  "bin": {
    "trame": "dist/index.js"
  },
  "exports": {
    "./export": "./src/export.ts",
    "./analysis": "./src/analysis.ts",
    "./doctor": "./src/doctor.ts",
    "./blame": "./src/blame.ts",
    "./communities": "./src/communities.ts",
    "./rules": "./src/rules.ts",
    "./types": "./src/types.ts",
    "./replay": "./src/replay.ts"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepack": "node scripts/stage-viewer.mjs"
  },
  "dependencies": {
    "ts-morph": "^28.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.20.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "description": "Google Maps for your frontend architecture — parse a TypeScript codebase and explore it as an interactive 3D map.",
  "keywords": [
    "architecture",
    "dependency-graph",
    "typescript",
    "react",
    "visualization",
    "3d",
    "ts-morph",
    "mermaid",
    "codebase",
    "cli"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Chahine-tech/trame.git",
    "directory": "packages/parser"
  },
  "homepage": "https://trame-61t.pages.dev",
  "bugs": {
    "url": "https://github.com/Chahine-tech/trame/issues"
  },
  "files": [
    "dist",
    "viewer",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  }
}
