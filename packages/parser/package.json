{
  "name": "tramejs",
  "version": "0.3.0",
  "type": "module",
  "bin": {
    "trame": "dist/index.js"
  },
  "exports": {
    "./export": {
      "types": "./dist/export.d.ts",
      "default": "./dist/export.js"
    },
    "./analysis": {
      "types": "./dist/analysis.d.ts",
      "default": "./dist/analysis.js"
    },
    "./doctor": {
      "types": "./dist/doctor.d.ts",
      "default": "./dist/doctor.js"
    },
    "./blame": {
      "types": "./dist/blame.d.ts",
      "default": "./dist/blame.js"
    },
    "./communities": {
      "types": "./dist/communities.d.ts",
      "default": "./dist/communities.js"
    },
    "./rules": {
      "types": "./dist/rules.d.ts",
      "default": "./dist/rules.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    },
    "./replay": {
      "types": "./dist/replay.d.ts",
      "default": "./dist/replay.js"
    }
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "check:package": "publint && attw --pack . --profile esm-only",
    "prepack": "node scripts/stage-viewer.mjs"
  },
  "dependencies": {
    "ts-morph": "^28.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/node": "^24.3.0",
    "publint": "^0.3.24",
    "tsx": "^4.20.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "description": "Google Maps for your frontend architecture — parse a TypeScript codebase and explore it as an interactive 3D map.",
  "keywords": [
    "architecture",
    "dependency-graph",
    "typescript",
    "react",
    "visualization",
    "3d",
    "ts-morph",
    "mermaid",
    "codebase",
    "cli"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Chahine-tech/trame.git",
    "directory": "packages/parser"
  },
  "homepage": "https://trame-61t.pages.dev",
  "bugs": {
    "url": "https://github.com/Chahine-tech/trame/issues"
  },
  "files": [
    "dist",
    "viewer",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  }
}
