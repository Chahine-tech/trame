{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    // node is for tests only: ink.test.ts reads tokens.css off disk, so the
    // contrast it asserts is the palette the app actually ships
    "types": ["vite/client", "node"],
    "noEmit": true
  },
  "include": ["src"]
}
