{
  "name": "trame",
  "private": true,
  "version": "0.2.1",
  "scripts": {
    "dev": "turbo dev --filter=@trame/viewer",
    "dev:site": "turbo dev --filter=@trame/site",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "parse": "pnpm --filter tramejs dev --",
    "test": "turbo test",
    "knip": "knip",
    "check:package": "pnpm --filter tramejs check:package"
  },
  "devDependencies": {
    "knip": "^6.32.2",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "turbo": "^2.5.0"
  },
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": ">=22"
  }
}
